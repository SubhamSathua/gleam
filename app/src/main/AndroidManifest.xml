<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Gleam">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Gleam">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- 1-Tap Toggle Shortcut Activity -->
        <activity
            android:name=".shortcut.ToggleShortcutActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true" />

        <!-- Quick Settings Notification Tile inside Control Panel -->
        <service
            android:name=".service.GleamTileService"
            android:exported="true"
            android:icon="@drawable/ic_sun_boost"
            android:label="Gleam Sun"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Widget Settings Configuration Activity -->
        <activity
            android:name=".widget.WidgetSettingsActivity"
            android:exported="true"
            android:theme="@style/Theme.Gleam">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- 1x1 Quick Toggle Widget -->
        <receiver
            android:name=".widget.GleamWidget1x1Provider"
            android:exported="true"
            android:label="Gleam Toggle (1x1)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.prism.gleam.ACTION_TOGGLE_POWER" />
                <action android:name="com.prism.gleam.ACTION_WIDGET_TOGGLE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_1x1" />
        </receiver>

        <!-- 2x1 Status Pill Widget -->
        <receiver
            android:name=".widget.GleamWidget2x2Provider"
            android:exported="true"
            android:label="Gleam Status Pill (2x1)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.prism.gleam.ACTION_TOGGLE_POWER" />
                <action android:name="com.prism.gleam.ACTION_WIDGET_TOGGLE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_2x2" />
        </receiver>

        <!-- 2x2 Square Widget -->
        <receiver
            android:name=".widget.GleamWidget4x4Provider"
            android:exported="true"
            android:label="Gleam Square (2x2)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.prism.gleam.ACTION_TOGGLE_POWER" />
                <action android:name="com.prism.gleam.ACTION_WIDGET_TOGGLE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_4x4" />
        </receiver>
    </application>

</manifest>
